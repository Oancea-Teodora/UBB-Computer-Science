<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Customer Feedback System</title>

</head>
<body>
    <div class="header">
        <div class="container">
            <h1>Customer Feedback System</h1>
        </div>
    </div>

    <div class="container">
        @if (ViewBag.SessionInfo != null)
        {
            <div class="session-info">
                <h3>Session Information</h3>
                <p><strong>Customer:</strong> @ViewBag.SessionInfo.CustomerName (@ViewBag.SessionInfo.CustomerEmail)</p>
                <p><strong>Flagged Submissions:</strong> @ViewBag.SessionInfo.FlaggedCount</p>
                @if (ViewBag.SessionInfo.IsRestricted)
                {
                    <p class="text-danger"><strong>Status:</strong> RESTRICTED - Cannot save feedback</p>
                }
            </div>
        }

        @RenderBody()
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html> 