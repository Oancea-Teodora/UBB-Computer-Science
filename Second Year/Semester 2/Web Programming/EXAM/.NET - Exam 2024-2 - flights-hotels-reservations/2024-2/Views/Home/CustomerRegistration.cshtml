@model CustomerRegistrationViewModel

<div class="card">
    <h2>Welcome to Customer Feedback System</h2>
    <p>Please provide your information to continue:</p>

    <form asp-action="RegisterCustomer" method="post">
        <div class="form-group">
            <label asp-for="Name">Full Name</label>
            <input asp-for="Name" class="form-control" placeholder="Enter your full name" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email">Email Address</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="Enter your email address" required />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Continue</button>
    </form>
</div> 